{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umbrella-inside-bet-v1",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "umbrella-inside-bet-v1",
      "database_id": "54bd7b93-8148-4e53-b74e-2375179756cc",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "0 6 * * *"
    ]
  }
}
